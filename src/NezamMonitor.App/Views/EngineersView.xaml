<UserControl x:Class="NezamMonitor.App.Views.EngineersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="👷 ناظرین" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Filter Panel -->
        <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                BorderBrush="#DEE2E6" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Filters -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🔍 جستجو:" VerticalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource LabelFontSize}"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Height="28" VerticalContentAlignment="Center" Margin="5,0" FontSize="{DynamicResource InputFontSize}"/>

                    <TextBlock Grid.Column="3" Text="مالک:" VerticalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource LabelFontSize}"/>
                    <ComboBox Grid.Column="4" ItemsSource="{Binding OwnerFilters}"
                              SelectedItem="{Binding FilterOwner}" Height="28" Margin="5,0" FontSize="{DynamicResource InputFontSize}"
                              IsEditable="True" StaysOpenOnEdit="True"/>

                    <TextBlock Grid.Column="6" Text="شماره پرونده:" VerticalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource LabelFontSize}"/>
                    <ComboBox Grid.Column="7" ItemsSource="{Binding CaseNumberFilters}"
                              SelectedItem="{Binding FilterCaseNumber}" Height="28" Margin="5,0" FontSize="{DynamicResource InputFontSize}"
                              IsEditable="True" StaysOpenOnEdit="True"/>

                    <TextBlock Grid.Column="9" Text="رشته:" VerticalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource LabelFontSize}"/>
                    <ComboBox Grid.Column="10" ItemsSource="{Binding DisciplineFilters}"
                              SelectedItem="{Binding FilterDiscipline}" Height="28" Margin="5,0" FontSize="{DynamicResource InputFontSize}"/>
                </Grid>

                <!-- Row 2: Engineer filter + Clear + Count -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="ناظر:" VerticalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource LabelFontSize}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding EngineerFilters}"
                              SelectedItem="{Binding FilterEngineer}" Height="28" Margin="5,0" FontSize="{DynamicResource InputFontSize}"
                              IsEditable="True" StaysOpenOnEdit="True"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Grid.Column="3" Content="🧹 پاک کردن فیلترها" Command="{Binding ClearFiltersCommand}"
                            Height="28" Padding="10,0" Background="#E74C3C" Foreground="White"
                            FontSize="{DynamicResource ButtonFontSize}" FontWeight="Bold"
                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisConverter}}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="5" Text="{Binding CountDisplay}" VerticalAlignment="Center"
                               Foreground="#7F8C8D" FontSize="{DynamicResource FontSize}" FontWeight="Bold"/>
                </Grid>
            </Grid>
        </Border>

        <!-- DataGrid with Context Menu -->
        <DataGrid Grid.Row="2" x:Name="EngineersGrid" ItemsSource="{Binding Engineers}" AutoGenerateColumns="False"
                  IsReadOnly="True" AlternatingRowBackground="#F8F9FA" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" BorderThickness="1" BorderBrush="#DEE2E6"
                  MouseRightButtonUp="EngineersGrid_MouseRightButtonUp" FlowDirection="{DynamicResource TableFlowDirection}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="پرونده" Binding="{Binding CaseNumber}" Width="100"/>
                <DataGridTextColumn Header="مالک" Binding="{Binding Owner}" Width="120"/>
                <DataGridTextColumn Header="رشته" Binding="{Binding Discipline}" Width="80"/>
                <DataGridTextColumn Header="ناظر" Binding="{Binding Name}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="#7F8C8D" FontSize="{DynamicResource LabelFontSize}" Margin="0,5,0,0"/>
    </Grid>
</UserControl>
