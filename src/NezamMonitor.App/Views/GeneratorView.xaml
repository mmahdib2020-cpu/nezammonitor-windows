<UserControl x:Class="NezamMonitor.App.Views.GeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header + Tab Navigation -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="📝 مدیریت گزارش‌ها" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,20,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="📝 تولید گزارش" Command="{Binding SwitchToGenerateCommand}"
                        Width="140" Height="32" Margin="0,0,5,0"
                        Background="{Binding ActiveTab, Converter={StaticResource TabBgConverter}, ConverterParameter=0}"
                        Foreground="{Binding ActiveTab, Converter={StaticResource TabFgConverter}, ConverterParameter=0}"
                        FontWeight="Bold" BorderThickness="1" BorderBrush="#BDC3C7"/>
                <Button Content="📚 گزارش‌های تولیدشده" Command="{Binding SwitchToHistoryCommand}"
                        Width="170" Height="32"
                        Background="{Binding ActiveTab, Converter={StaticResource TabBgConverter}, ConverterParameter=1}"
                        Foreground="{Binding ActiveTab, Converter={StaticResource TabFgConverter}, ConverterParameter=1}"
                        FontWeight="Bold" BorderThickness="1" BorderBrush="#BDC3C7"/>
            </StackPanel>
        </Grid>

        <!-- Tab 0: Generation -->
        <Border Grid.Row="1" Visibility="{Binding ActiveTab, Converter={StaticResource TabToVisConverter}, ConverterParameter=0}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Settings Card -->
                    <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#BDC3C7" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="تنظیم تولید" FontSize="{DynamicResource FontSize}" FontWeight="Bold" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="مرحله:" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Content="مرحله اول" IsChecked="True" Margin="0,0,15,0" GroupName="Stage" Tag="1" Checked="StageRadio_Checked"/>
                                    <RadioButton Content="مرحله دوم" Margin="0,0,15,0" GroupName="Stage" Tag="2" Checked="StageRadio_Checked"/>
                                    <RadioButton Content="مرحله سوم" GroupName="Stage" Tag="3" Checked="StageRadio_Checked"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="تمپلیت:" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTemplateName}" VerticalAlignment="Center" Foreground="#2C3E50" FontWeight="Bold"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="📂 انتخاب" Command="{Binding BrowseTemplateCommand}" Height="26" Background="#3498DB" Foreground="White" FontSize="{DynamicResource LabelFontSize}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="تاریخ گزارش:" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReportDate}" VerticalAlignment="Center" Foreground="#27AE60" FontWeight="Bold" FontSize="{DynamicResource FontSize}"/>
                                <!-- LTR Checkbox -->
                                <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" IsChecked="{Binding UseLtr}"
                                          VerticalAlignment="Center" Margin="0,2,0,0">
                                    <TextBlock Text="تولید چپ‌چین">
                                        <TextBlock.ToolTip>برای اعداد و شناسه‌های دارای /، جهت نمایش را چپ‌به‌راست می‌کند تا ترتیب اعداد صحیح نمایش داده شود.</TextBlock.ToolTip>
                                    </TextBlock>
                                </CheckBox>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="مسیر خروجی:" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OutputPath}" VerticalAlignment="Center" Foreground="#7F8C8D" FontSize="{DynamicResource LabelFontSize}" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Row="4" Grid.Column="2" Content="📂 تغییر" Command="{Binding BrowseOutputCommand}" Height="26" Background="#95A5A6" Foreground="White" FontSize="{DynamicResource LabelFontSize}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Button Content="🔄 اسکن پرونده‌ها" Command="{Binding ScanCommand}" Width="120" Height="32" Background="#3498DB" Foreground="White" Margin="0,0,5,0"/>
                        <Button Content="👁 پیش‌نمایش" Command="{Binding PreviewCommand}" Width="100" Height="32" Background="#9B59B6" Foreground="White" Margin="0,0,5,0"/>
                        <Button Content="☑️ انتخاب همه" Command="{Binding SelectAllCommand}" Width="100" Height="32" Background="#27AE60" Foreground="White" Margin="0,0,5,0"/>
                        <Button Content="☐ حذف انتخاب" Command="{Binding DeselectAllCommand}" Width="100" Height="32" Background="#E74C3C" Foreground="White" Margin="0,0,10,0"/>
                        <Button Content="📝 تولید گزارش‌های انتخاب‌شده" Command="{Binding GenerateCommand}" Width="210" Height="32" Background="#F39C12" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                    <!-- Progress -->
                    <Grid Margin="0,0,0,15">
                        <ProgressBar Height="18" Value="{Binding Progress}" Maximum="100" Foreground="#2ECC71" Background="#ECF0F1" BorderThickness="0"/>
                        <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource LogFontSize}"/>
                    </Grid>
                    <!-- Preview -->
                    <Border Background="#F8F9FA" CornerRadius="6" Padding="10" Margin="0,0,0,15" BorderBrush="#DEE2E6" BorderThickness="1"
                            Visibility="{Binding PreviewText, Converter={StaticResource StringToVisConverter}}">
                        <TextBlock Text="{Binding PreviewText}" FontFamily="Consolas" FontSize="{DynamicResource LabelFontSize}" Foreground="#2C3E50" TextWrapping="Wrap"/>
                    </Border>
                    <!-- Case Table with Context Menu -->
                    <DataGrid x:Name="CaseGrid" ItemsSource="{Binding ReportStatus}" AutoGenerateColumns="False" IsReadOnly="False"
                              AlternatingRowBackground="#F8F9FA" GridLinesVisibility="Horizontal" MaxHeight="350"
                              HeadersVisibility="Column" BorderThickness="1" BorderBrush="#DEE2E6"
                              MouseRightButtonUp="CaseGrid_MouseRightButtonUp" FlowDirection="{DynamicResource TableFlowDirection}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="انتخاب" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                            <DataGridTextColumn Header="ردیف" Binding="{Binding RowNumber}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="مالک" Binding="{Binding Owner}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="شماره پرونده" Binding="{Binding CaseNumber}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="مرحله" Binding="{Binding Stage}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="120" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#7F8C8D" FontSize="{DynamicResource LabelFontSize}" Margin="0,5,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Tab 1: History -->
        <Border Grid.Row="1" Visibility="{Binding ActiveTab, Converter={StaticResource TabToVisConverter}, ConverterParameter=1}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="📚 گزارش‌های تولیدشده" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <Button Content="🔄" Command="{Binding RefreshHistoryCommand}" Width="26" Height="26" Background="#3498DB" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Button Content="🔄 بروزرسانی" Command="{Binding SyncOutputCommand}" Width="90" Height="26" Background="#27AE60" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SyncMessage}" Foreground="#27AE60" FontSize="{DynamicResource LabelFontSize}" FontWeight="Bold" Margin="0,0,0,10" Visibility="{Binding SyncMessage, Converter={StaticResource StringToVisConverter}}"/>
                    <!-- Filters -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}" Height="26" VerticalContentAlignment="Center" Margin="0,0,5,0" Padding="5" ToolTip="جستجو بر اساس نام مالک یا شماره پرونده"/>
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding HistoryFilterStage}" Height="26" Margin="0,0,5,0">
                            <ComboBoxItem Content="همه مراحل"/>
                            <ComboBoxItem Content="مرحله اول"/>
                            <ComboBoxItem Content="مرحله دوم"/>
                            <ComboBoxItem Content="مرحله سوم"/>
                        </ComboBox>
                        <ComboBox Grid.Column="2" SelectedIndex="{Binding HistoryFilterFormat}" Height="26">
                            <ComboBoxItem Content="همه جهت‌ها"/>
                            <ComboBoxItem Content="فارسی"/>
                            <ComboBoxItem Content="چپ‌چین"/>
                        </ComboBox>
                    </Grid>
                    <!-- History Table with Context Menu -->
                    <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding ReportHistory}" AutoGenerateColumns="False" IsReadOnly="True"
                              AlternatingRowBackground="#F8F9FA" GridLinesVisibility="Horizontal" MaxHeight="400"
                              HeadersVisibility="Column" BorderThickness="1" BorderBrush="#DEE2E6"
                              MouseRightButtonUp="HistoryGrid_MouseRightButtonUp" FlowDirection="{DynamicResource TableFlowDirection}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="مالک" Binding="{Binding OwnerName}" Width="150"/>
                            <DataGridTextColumn Header="پرونده" Binding="{Binding CaseNumber}" Width="100"/>
                            <DataGridTextColumn Header="مرحله" Binding="{Binding StageName}" Width="80"/>
                            <DataGridTextColumn Header="تاریخ" Binding="{Binding CreatedAt}" Width="100"/>
                            <DataGridTextColumn Header="جهت" Binding="{Binding NumberFormat}" Width="70"/>
                            <DataGridTextColumn Header="فایل" Binding="{Binding FileName}" Width="220"/>
                            <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="80"/>
                            <DataGridTemplateColumn Header="عملیات" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="📄" ToolTip="باز کردن" Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Width="25" Height="22" Margin="2,0" Background="#3498DB" Foreground="White" FontSize="{DynamicResource LogFontSize}"/>
                                            <Button Content="📂" ToolTip="باز کردن پوشه" Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Width="25" Height="22" Margin="2,0" Background="#27AE60" Foreground="White" FontSize="{DynamicResource LogFontSize}"/>
                                            <Button Content="🔄" ToolTip="تولید مجدد" Command="{Binding DataContext.RegenerateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Width="25" Height="22" Margin="2,0" Background="#F39C12" Foreground="White" FontSize="{DynamicResource LogFontSize}"/>
                                            <Button Content="🗑" ToolTip="حذف لاگ" Command="{Binding DataContext.DeleteLogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Width="25" Height="22" Margin="2,0" Background="#E74C3C" Foreground="White" FontSize="{DynamicResource LogFontSize}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#7F8C8D" FontSize="{DynamicResource LabelFontSize}" Margin="0,5,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
