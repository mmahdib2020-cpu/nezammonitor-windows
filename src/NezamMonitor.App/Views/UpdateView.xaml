<UserControl x:Class="NezamMonitor.App.Views.UpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:srv="clr-namespace:NezamMonitor.App.Services">
    <UserControl.Resources>
        <Style x:Key="ExtractionBtn" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,5"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="🔄 به‌روزرسانی و همگام‌سازی" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- 1. Login -->
            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15"
                    BorderBrush="#BDC3C7" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="🔑 اطلاعات ورود به سامانه" FontSize="{DynamicResource FontSize}" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="نام کاربری:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,20,0"/>
                        <TextBlock Grid.Column="2" Text="رمز عبور:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <PasswordBox Grid.Column="3" x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged"/>
                    </Grid>
                    <CheckBox Content="🔑 ذخیره اطلاعات ورود" IsChecked="{Binding RememberMe}" Margin="0,8,0,0" FontSize="{DynamicResource LabelFontSize}"/>
                </StackPanel>
            </Border>

            <!-- 2. Options -->
            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15"
                    BorderBrush="#BDC3C7" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="⚙️ گزینه‌های استخراج" FontSize="{DynamicResource FontSize}" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="شروع از پرونده شماره:" VerticalAlignment="Center" Width="150"/>
                        <TextBox Text="{Binding StartFromIndex, UpdateSourceTrigger=PropertyChanged, Source={x:Static srv:ExtractionController.Instance}}"
                                 Width="80" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="تعداد:" VerticalAlignment="Center" Width="50" Margin="10,0,0,0"/>
                        <TextBox Text="{Binding MaxCases, UpdateSourceTrigger=PropertyChanged, Source={x:Static srv:ExtractionController.Instance}}"
                                 Width="80" Height="28" VerticalContentAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="(0=همه)" Foreground="Gray" FontSize="{DynamicResource LabelFontSize}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <CheckBox Content="🔍 فقط پرونده‌های ناقص (بدون مشخصات/گزارش/ناظرین/حق‌الزحمه)"
                              IsChecked="{Binding FilterIncompleteOnly, Source={x:Static srv:ExtractionController.Instance}}"
                              Margin="0,8,0,5" FontSize="{DynamicResource FontSize}"/>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0"
                                Visibility="{Binding ExtractSpecifications, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="حالت:" VerticalAlignment="Center" Width="50" FontWeight="Bold"/>
                        <RadioButton Content="فقط ناقص" IsChecked="{Binding UpdateAllSpecifications, Converter={StaticResource InverseBoolConverter}, Source={x:Static srv:ExtractionController.Instance}}"
                                     Margin="0,0,20,0" VerticalAlignment="Center" GroupName="SpecMode"/>
                        <RadioButton Content="بازنویسی" IsChecked="{Binding UpdateAllSpecifications, Source={x:Static srv:ExtractionController.Instance}}"
                                     Margin="0,0,20,0" VerticalAlignment="Center" GroupName="SpecMode"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. Report File Options -->
            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15"
                    BorderBrush="#BDC3C7" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📁 گزینه‌های فایل" FontSize="{DynamicResource FontSize}" FontWeight="Bold" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="مسیر ذخیره فایل‌ها:" VerticalAlignment="Center" Width="120"/>
                        <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" Width="400" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="📁 انتخاب" Width="80" Height="28" Click="BtnBrowseOutput_Click"/>
                    </StackPanel>
                    <CheckBox Content="📥 دانلود فایل‌های گزارش (تصاویر/PDF)" IsChecked="{Binding ExtractReportFiles}" Margin="0,0,0,5" FontSize="{DynamicResource FontSize}"/>
                </StackPanel>
            </Border>

            <!-- 4. Buttons -->
            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15"
                    BorderBrush="#BDC3C7" BorderThickness="1">
                <WrapPanel>
                    <Button x:Name="BtnStart" Style="{StaticResource ExtractionBtn}" Width="180"
                            Background="#27AE60" Click="BtnStart_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄  " FontSize="{DynamicResource FontSize}"/>
                            <TextBlock Text="شروع استخراج" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnStop" Style="{StaticResource ExtractionBtn}" Width="130"
                            Background="#E74C3C" Click="BtnStop_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏹  " FontSize="{DynamicResource FontSize}"/>
                            <TextBlock Text="توقف" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnPause" Style="{StaticResource ExtractionBtn}" Width="130"
                            Background="#F39C12" Content="⏸ وقفه" Click="BtnPause_Click"/>
                    <Button x:Name="BtnLoad" Style="{StaticResource ExtractionBtn}" Width="180"
                            Background="#3498DB" Click="BtnLoad_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📥  " FontSize="{DynamicResource FontSize}"/>
                            <TextBlock Text="بارگذاری آخرین" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Border>

            <!-- 5. Progress -->
            <Grid Margin="0,0,0,15">
                <ProgressBar x:Name="ProgressBar" Height="20" Maximum="100"
                             Foreground="#2ECC71" Background="#ECF0F1" BorderThickness="0"/>
                <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="{DynamicResource LabelFontSize}" FontWeight="Bold"/>
            </Grid>

            <!-- 6. Log -->
            <Border Background="#2C3E50" CornerRadius="8" Padding="10">
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" Foreground="#ECF0F1" FontFamily="Consolas"
                               FontSize="{DynamicResource LabelFontSize}" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
