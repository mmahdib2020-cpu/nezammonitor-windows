<UserControl x:Class="NezamMonitor.App.Views.ChangesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📈 مقایسه اسنپ‌شات‌ها" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="از:" VerticalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource FontSize}"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Snapshots}" SelectedValue="{Binding FromSnapshotId}"
                      SelectedValuePath="Id" DisplayMemberPath="DisplayText" Width="250" Margin="5,0" FontSize="{DynamicResource FontSize}"/>
            <TextBlock Grid.Column="2" Text="تا:" VerticalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource FontSize}"/>
            <ComboBox Grid.Column="3" ItemsSource="{Binding Snapshots}" SelectedValue="{Binding ToSnapshotId}"
                      SelectedValuePath="Id" DisplayMemberPath="DisplayText" Width="250" Margin="5,0" FontSize="{DynamicResource FontSize}"/>
        </Grid>

        <Button Grid.Row="2" Content="🔍 مقایسه" Command="{Binding CompareCommand}"
                Width="120" Height="35" Background="#3498DB" Foreground="White"
                FontWeight="Bold" FontSize="{DynamicResource ButtonFontSize}" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Changes}" AutoGenerateColumns="False"
                  IsReadOnly="True" AlternatingRowBackground="#F8F9FA" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" BorderThickness="1" BorderBrush="#DEE2E6" FlowDirection="{DynamicResource TableFlowDirection}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="پرونده" Binding="{Binding CaseNumber}" Width="100"/>
                <DataGridTextColumn Header="مالک" Binding="{Binding Owner}" Width="120"/>
                <DataGridTextColumn Header="نوع" Binding="{Binding ChangeType}" Width="80"/>
                <DataGridTextColumn Header="فیلد" Binding="{Binding Field}" Width="100"/>
                <DataGridTextColumn Header="مقدار قبلی" Binding="{Binding OldValue}" Width="150"/>
                <DataGridTextColumn Header="مقدار جدید" Binding="{Binding NewValue}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,5,0,0">
            <TextBlock Text="{Binding SummaryText}" Foreground="#2C3E50" FontWeight="Bold" FontSize="{DynamicResource FontSize}"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#7F8C8D" Margin="20,0,0,0" FontSize="{DynamicResource LabelFontSize}"/>
        </StackPanel>
    </Grid>
</UserControl>
