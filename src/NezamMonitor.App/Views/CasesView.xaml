<UserControl x:Class="NezamMonitor.App.Views.CasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: Title + Search + Refresh -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="📋 پرونده‌ها" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" Margin="0,0,15,0"
                       VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Content="🔄" Command="{Binding RefreshCommand}"
                    Width="30" Height="30" Background="#3498DB" Foreground="White"/>
        </Grid>

        <!-- Main Table with Horizontal Scroll -->
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="#DEE2E6" CornerRadius="4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid x:Name="CasesGrid" ItemsSource="{Binding Cases}" AutoGenerateColumns="False"
                          IsReadOnly="True" AlternatingRowBackground="#F8F9FA" GridLinesVisibility="All"
                          HeadersVisibility="Column" BorderThickness="0" MinWidth="2200"
                          SelectionMode="Single" SelectionChanged="CasesGrid_SelectionChanged" FlowDirection="{DynamicResource TableFlowDirection}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ردیف" Binding="{Binding RowNumber}" Width="50"/>
                        <DataGridTextColumn Header="شماره پرونده" Binding="{Binding CaseNumber}" Width="100"/>
                        <DataGridTextColumn Header="شماره سریال" Binding="{Binding Serial}" Width="70"/>
                        <DataGridTextColumn Header="نام مالک" Binding="{Binding Owner}" Width="130"/>
                        <DataGridTextColumn Header="همراه مالک" Binding="{Binding OwnerMobile}" Width="100"/>
                        <DataGridTextColumn Header="نوع کاربری" Binding="{Binding UsageType}" Width="80"/>
                        <DataGridTextColumn Header="گروه ساختمانی" Binding="{Binding BuildingGroup}" Width="90"/>
                        <DataGridTextColumn Header="کد نوسازی" Binding="{Binding RenovationCode}" Width="120"/>
                        <DataGridTextColumn Header="شماره دستور نقشه" Binding="{Binding PlanInstructionNo}" Width="100"/>
                        <DataGridTextColumn Header="نوع دستور نقشه" Binding="{Binding PlanInstructionType}" Width="90"/>
                        <DataGridTextColumn Header="تاریخ دستور نقشه" Binding="{Binding PlanInstructionDate}" Width="100"/>
                        <DataGridTextColumn Header="مساحت زمین" Binding="{Binding LandArea}" Width="80"/>
                        <DataGridTextColumn Header="متراژ پاراف" Binding="{Binding ParafArea}" Width="90"/>
                        <DataGridTextColumn Header="متراژ کسر ظرفیت" Binding="{Binding CapacityArea}" Width="100"/>
                        <DataGridTextColumn Header="نوع سازه" Binding="{Binding StructureType}" Width="70"/>
                        <DataGridTextColumn Header="عنوان بلوک" Binding="{Binding BlockTitle}" Width="80"/>
                        <DataGridTextColumn Header="تعداد بلوک" Binding="{Binding BlockCount}" Width="70"/>
                        <DataGridTextColumn Header="طبقات" Binding="{Binding Floors}" Width="50"/>
                        <DataGridTextColumn Header="واحدها" Binding="{Binding Units}" Width="50"/>
                        <DataGridTextColumn Header="صادرکننده پروانه" Binding="{Binding Issuer}" Width="110"/>
                        <DataGridTextColumn Header="شماره پروانه" Binding="{Binding PermitNumber}" Width="90"/>
                        <DataGridTextColumn Header="تاریخ صدور پروانه" Binding="{Binding PermitDate}" Width="100"/>
                        <DataGridTextColumn Header="تاریخ ترخیص" Binding="{Binding ReleaseDate}" Width="90"/>
                        <DataGridTextColumn Header="محدوده طرح" Binding="{Binding PlanZone}" Width="80"/>
                        <DataGridTextColumn Header="آدرس" Binding="{Binding Address}" Width="150"/>
                        <DataGridTextColumn Header="دفتر" Binding="{Binding Office}" Width="100"/>
                        <DataGridTextColumn Header="تاریخ کسر ظرفیت" Binding="{Binding CapacityDate}" Width="100"/>
                        <DataGridTextColumn Header="مسئولیت" Binding="{Binding Responsibility}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </ScrollViewer>
        </Border>

        <!-- Status Bar -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#7F8C8D" FontSize="{DynamicResource LabelFontSize}" Margin="0,5,0,5"/>

        <!-- Detail Panel (Bottom, Horizontal) -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="15"
                BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,5,0,0"
                Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Detail Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="📄 جزئیات پرونده" FontSize="{DynamicResource FontSize}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding DetailTitle}" Foreground="#3498DB" FontWeight="Bold"
                               FontSize="{DynamicResource FontSize}" Margin="15,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="✕" Command="{Binding CloseDetailCommand}"
                            Width="25" Height="25" Background="#E74C3C" Foreground="White"
                            HorizontalAlignment="Right" Margin="0,0,0,0"/>
                </StackPanel>

                <!-- 4-Column Horizontal Detail -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid MinWidth="900">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column 1: Engineers -->
                        <Border Grid.Column="0" Background="#EBF5FB" CornerRadius="6" Padding="10" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="👷 ناظرین" FontWeight="Bold" FontSize="{DynamicResource FontSize}" Margin="0,0,0,8"
                                           Foreground="#2C3E50"/>
                                <TextBlock Text="{Binding DetailEngineers}" TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontSize}" Foreground="#34495E" FontFamily="Tahoma"/>
                            </StackPanel>
                        </Border>

                        <!-- Column 2: Fees -->
                        <Border Grid.Column="1" Background="#FEF9E7" CornerRadius="6" Padding="10" Margin="2,0">
                            <StackPanel>
                                <TextBlock Text="💰 حق‌الزحمه" FontWeight="Bold" FontSize="{DynamicResource FontSize}" Margin="0,0,0,8"
                                           Foreground="#2C3E50"/>
                                <TextBlock Text="{Binding DetailFees}" TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontSize}" Foreground="#34495E" FontFamily="Tahoma"/>
                            </StackPanel>
                        </Border>

                        <!-- Column 3: Reports -->
                        <Border Grid.Column="2" Background="#F5EEF8" CornerRadius="6" Padding="10" Margin="2,0">
                            <StackPanel>
                                <TextBlock Text="📄 گزارش‌ها" FontWeight="Bold" FontSize="{DynamicResource FontSize}" Margin="0,0,0,8"
                                           Foreground="#2C3E50"/>
                                <TextBlock Text="{Binding DetailReports}" TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontSize}" Foreground="#34495E" FontFamily="Tahoma"/>
                            </StackPanel>
                        </Border>

                        <!-- Column 4: Specifications -->
                        <Border Grid.Column="3" Background="#E8F8F5" CornerRadius="6" Padding="10" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="📋 مشخصات" FontWeight="Bold" FontSize="{DynamicResource FontSize}" Margin="0,0,0,8"
                                           Foreground="#2C3E50"/>
                                <TextBlock Text="{Binding DetailSpecs}" TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontSize}" Foreground="#34495E" FontFamily="Tahoma"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
