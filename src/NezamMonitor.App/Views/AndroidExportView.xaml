<UserControl x:Class="NezamMonitor.App.Views.AndroidExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="📱 خروجی برای اندروید" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" Margin="0,0,0,15"/>

            <!-- Info Card -->
            <Border Grid.Row="1" Background="#EBF5FB" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#3498DB" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="این ابزار فایل داده‌ی `.nzmdata` برای وارد کردن در برنامه اندروید ایجاد می‌کند." 
                               FontSize="{DynamicResource FontSize}" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource LabelFontSize}" Foreground="#5D6D7E">
                        فایل خروجی شامل تمام پرونده‌ها، مهندسین، حق‌الزحمه، گزارش‌ها و ویرایش‌های پیگیری است.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Output Path Section -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15"
                    BorderBrush="#DEE2E6" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="مسیر ذخیره:" VerticalAlignment="Center" FontWeight="Bold" 
                               FontSize="{DynamicResource FontSize}" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding OutputPath, Mode=OneWay}" IsReadOnly="True" 
                             Width="300" Height="30" VerticalContentAlignment="Center" FontSize="{DynamicResource InputFontSize}" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="📁 انتخاب مسیر" Command="{Binding BrowseCommand}" 
                            Height="30" Width="120" Background="#3498DB" Foreground="White" 
                            FontSize="{DynamicResource ButtonFontSize}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Status -->
            <Border Grid.Row="3" Background="#2C3E50" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#2ECC71" FontSize="{DynamicResource FontSize}" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <!-- Progress indicator -->
                    <ProgressBar IsIndeterminate="{Binding IsExporting}" Height="6" Background="#34495E" Foreground="#2ECC71" Margin="0,0,0,10"/>
                    
                    <!-- Export info -->
                    <TextBlock Text="{Binding LastExportInfo}" TextWrapping="Wrap" Foreground="#ECF0F1" 
                               FontSize="{DynamicResource LabelFontSize}" LineHeight="22"/>
                </StackPanel>
            </Border>

            <!-- Export Button -->
            <Button Grid.Row="4" Content="📦 ایجاد خروجی اندروید" Command="{Binding ExportCommand}" 
                    Height="45" Background="#27AE60" Foreground="White" FontSize="{DynamicResource FontSize}" 
                    FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15" Width="250"/>
        </Grid>
    </ScrollViewer>
</UserControl>
