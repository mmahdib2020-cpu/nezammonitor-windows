<UserControl x:Class="NezamMonitor.App.Views.FollowUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NezamMonitor.App.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:ReportCountConverter x:Key="ReportCountConverter"/>
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- هدر -->
        <TextBlock Grid.Row="0" Text="📋 پیگیری پرونده‌ها" FontSize="{DynamicResource HeadingFontSize}" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- پنل فیلتر -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,15"
                BorderBrush="#BDC3C7" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🔍 جستجو:" VerticalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource LabelFontSize}" Margin="0,0,5,0"/>
                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="28" FontSize="{DynamicResource InputFontSize}" VerticalContentAlignment="Center" Padding="5" Margin="0,0,10,0"/>

                <TextBlock Grid.Column="2" Text="مالک:" VerticalAlignment="Center" FontWeight="Bold" FontSize="{DynamicResource LabelFontSize}" Margin="0,0,5,0"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding DistinctOwners}" SelectedItem="{Binding FilterOwner}"
                          Height="28" FontSize="{DynamicResource InputFontSize}" Width="180" Margin="0,0,10,0"/>

                <Button Grid.Column="4" Content="💾 ذخیره" Command="{Binding SaveCommand}"
                        Height="28" Background="#27AE60" Foreground="White" FontSize="{DynamicResource ButtonFontSize}" Margin="0,0,5,0"/>
                <Button Grid.Column="5" Content="🔄 بروزرسانی" Command="{Binding RefreshCommand}"
                        Height="28" Background="#3498DB" Foreground="White" FontSize="{DynamicResource ButtonFontSize}" Margin="0,0,5,0"/>
                <Button Grid.Column="6" Content="📁 دسته‌بندی بر اساس محدوده"
                        Command="{Binding GroupByRangeCommand}"
                        Height="28" Background="#9B59B6" Foreground="White" FontSize="{DynamicResource ButtonFontSize}"/>
            </Grid>
        </Border>

        <!-- جدول داده -->
        <DataGrid x:Name="FollowUpGrid" Grid.Row="2" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  AlternatingRowBackground="#F8F9FA" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" BorderThickness="1" BorderBrush="#DEE2E6"
                  SelectionUnit="Cell" SelectionMode="Extended"
                  MouseRightButtonUp="FollowUpGrid_MouseRightButtonUp"
                  CellEditEnding="FollowUpGrid_CellEditEnding" FlowDirection="{DynamicResource TableFlowDirection}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ردیف" Binding="{Binding RowId}" Width="50" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="شماره پرونده" Binding="{Binding CaseNumber, Mode=TwoWay}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCaseNumberModified}" Value="True">
                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="نام مالک" Binding="{Binding Owner, Mode=TwoWay}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOwnerModified}" Value="True">
                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="آدرس" Binding="{Binding Address, Mode=TwoWay}" Width="250">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAddressModified}" Value="True">
                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="همراه مالک" Binding="{Binding OwnerMobile, Mode=TwoWay}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOwnerMobileModified}" Value="True">
                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="تعداد گزارش" Binding="{Binding ReportCount}" Width="90" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ReportCount}" Value="0">
                                    <Setter Property="Foreground" Value="#95A5A6"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ReportCount}" Value="1">
                                    <Setter Property="Foreground" Value="#27AE60"/>
                                </DataTrigger>
                                <DataTrigger>
                                    <DataTrigger.Binding>
                                        <Binding Path="ReportCount" Converter="{StaticResource ReportCountConverter}"/>
                                    </DataTrigger.Binding>
                                    <Setter Property="Foreground" Value="#E67E22"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="توضیحات" Binding="{Binding Description, Mode=TwoWay}" Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
                            <Setter Property="Foreground" Value="#8E44AD"/>
                            <Setter Property="FontStyle" Value="Italic"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="MaxHeight" Value="120"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- نوار وضعیت -->
        <TextBlock Grid.Row="3" Text="{Binding CountDisplay}" Foreground="#7F8C8D" FontSize="{DynamicResource FontSize}"
                   FontWeight="Bold" Margin="0,5,0,0"/>
    </Grid>
</UserControl>
