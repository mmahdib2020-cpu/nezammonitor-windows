<Window x:Class="NezamMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سیستم مانیتور نظم مهندسی یزد"
        Width="1200" Height="750"
        MinWidth="800" MinHeight="500"
        FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource FontFamily}"
        Icon="pack://application:,,,/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource PrimaryBrush}" Padding="15,0">
            <Grid>
                <TextBlock Text="سیستم مانیتور نظم مهندسی یزد" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Navigation Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SidebarBrush}" Padding="0,10,0,0">
            <ScrollViewer>
                <StackPanel x:Name="SidebarStackPanel">
                    <TextBlock Text="منوی اصلی" Foreground="{DynamicResource SidebarTextBrush}" FontSize="14" FontWeight="Bold" Margin="15,5,15,10"/>
                    <RadioButton Content="📊 داشبورد" Style="{StaticResource NavButton}" Foreground="{DynamicResource SidebarTextBrush}" Background="#34495E"
                                 IsChecked="True" Click="Nav_Click" Tag="dashboard"/>
                    <RadioButton Content="📋 پرونده‌ها" Style="{StaticResource NavButton}" Foreground="{DynamicResource SidebarTextBrush}" Background="#34495E"
                                 Click="Nav_Click" Tag="cases"/>
                    <RadioButton Content="⚙️ به‌روزرسانی" Style="{StaticResource NavButton}" Foreground="{DynamicResource SidebarTextBrush}" Background="#34495E"
                                 Click="Nav_Click" Tag="update"/>
                    <RadioButton Content="📈 تغییرات" Style="{StaticResource NavButton}" Foreground="{DynamicResource SidebarTextBrush}" Background="#34495E"
                                 Click="Nav_Click" Tag="changes"/>
                    <RadioButton Content="👷 مهندسین" Style="{StaticResource NavButton}" Foreground="{DynamicResource SidebarTextBrush}" Background="#34495E"
                                 Click="Nav_Click" Tag="engineers"/>
                    <RadioButton Content="💰 حق‌الزحمه" Style="{StaticResource NavButton}" Foreground="{DynamicResource SidebarTextBrush}" Background="#34495E"
                                 Click="Nav_Click" Tag="fees"/>
                    <RadioButton Content="📄 گزارش‌ها" Style="{StaticResource NavButton}" Foreground="{DynamicResource SidebarTextBrush}" Background="#34495E"
                                 Click="Nav_Click" Tag="reports"/>
                    <RadioButton Content="📝 تولید گزارش" Style="{StaticResource NavButton}" Foreground="{DynamicResource SidebarTextBrush}" Background="#34495E"
                                 Click="Nav_Click" Tag="generator"/>
                    <RadioButton Content="📤 خروجی اکسل" Style="{StaticResource NavButton}" Foreground="{DynamicResource SidebarTextBrush}" Background="#34495E"
                                 Click="Nav_Click" Tag="excel"/>
                    <RadioButton Content="📱 خروجی اندروید" Style="{StaticResource NavButton}" Foreground="{DynamicResource SidebarTextBrush}" Background="#34495E"
                                 Click="Nav_Click" Tag="androidexport"/>
                    <RadioButton Content="📜 تاریخچه" Style="{StaticResource NavButton}" Foreground="{DynamicResource SidebarTextBrush}" Background="#34495E"
                                 Click="Nav_Click" Tag="history"/>
                    <RadioButton Content="📌 پیگیری" Style="{StaticResource NavButton}" Foreground="{DynamicResource SidebarTextBrush}" Background="#34495E"
                                 Click="Nav_Click" Tag="followup"/>
                    <RadioButton Content="⚙️ تنظیمات" Style="{StaticResource NavButton}" Foreground="{DynamicResource SidebarTextBrush}" Background="#34495E"
                                 Click="Nav_Click" Tag="settings"/>
                    <Separator Background="#4A6274" Margin="10,8"/>
                    <Image Source="pack://application:,,,/app_logo.png" Width="80" Height="80"
                           HorizontalAlignment="Center" Margin="0,5,0,5"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="نسخه ۲.۰.۰" Foreground="#7F8C8D" FontSize="{DynamicResource FontSize}"
                               HorizontalAlignment="Center" Margin="0,0,0,3"/>
                    <TextBlock Text="ساخته شده توسط محمد مهدی برخورداری"
                               Foreground="#7F8C8D" FontSize="{DynamicResource FontSize}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,0,5"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Content Area -->
        <Frame x:Name="MainFrame" Grid.Row="1" Grid.Column="1" NavigationUIVisibility="Hidden" Background="Transparent"/>

        <!-- Status Bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource PrimaryBrush}" Padding="10,3">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#AED6F1" FontSize="11" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ProgressBar Width="150" Height="12" Value="{Binding Progress}" Maximum="100" Margin="0,0,10,0"
                                 Foreground="#2ECC71" Background="#34495E" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>